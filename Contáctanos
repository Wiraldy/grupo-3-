<script>
document.getElementById('mb-btn').addEventListener('click',()=>document.getElementById('mb-menu').classList.toggle('hidden'));

function enviarMensaje(){
    const nom=document.getElementById('f-nom').value.trim();
    const email=document.getElementById('f-email').value.trim();
    const asunto=document.getElementById('f-asunto').value;
    const msg=document.getElementById('f-msg').value.trim();
    const btn=document.getElementById('send-btn');
    if(!nom||!email||!asunto||!msg){
        btn.style.background='linear-gradient(135deg,#ef4444,#dc2626)';
        btn.innerHTML='<i class="fas fa-exclamation-circle" style="margin-right:8px;"></i>Completa todos los campos';
        setTimeout(()=>{btn.style.background='';btn.innerHTML='<i class="fas fa-paper-plane" style="margin-right:8px;"></i> ENVIAR MENSAJE';},2200);
        return;
    }
    btn.innerHTML='<i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i>Enviando…';
    btn.disabled=true;
    setTimeout(()=>{
        btn.innerHTML='<i class="fas fa-check" style="margin-right:8px;"></i>¡ENVIADO!';
        btn.style.background='linear-gradient(135deg,#16a34a,#22c55e)';
        const box=document.getElementById('success-box');
        box.style.display='flex';
        ['f-nom','f-ape','f-email','f-tel','f-msg'].forEach(id=>document.getElementById(id).value='');
        document.getElementById('f-asunto').value='';
        setTimeout(()=>{
            btn.innerHTML='<i class="fas fa-paper-plane" style="margin-right:8px;"></i> ENVIAR MENSAJE';
            btn.style.background='';btn.disabled=false;box.style.display='none';
        },4000);
    },1600);
}
</script>
